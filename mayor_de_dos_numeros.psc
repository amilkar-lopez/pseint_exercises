Algoritmo mayor_de_dos_numeros
	// Realizar un algoritmo para calcular el mayor de dos números enteros leídos
	// por teclado
	Escribir "Calculo mayor de 2 numeros"
	Definir numero1, numero2 como Entero
	Escribir "Ingrese primer numero"
	Leer numero1
	Escribir "Ingrese segundo numero"
	Leer numero2
	Si numero1 < numero2 Entonces
		Escribir "El mayor es:", numero2
	SiNo
		Escribir "El mayor es: ", numero1
	FinSi
FinAlgoritmo
